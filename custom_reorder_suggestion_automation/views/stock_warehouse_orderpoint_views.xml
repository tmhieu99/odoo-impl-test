<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom Re-Order Suggestions replenishment page (mockup).
         Separate from the native replenishment page, which is left intact. -->
    <record id="view_reorder_suggestion_replenishment_list" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.reorder.suggestion.list</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="arch" type="xml">
            <list string="Re-Order Suggestions" editable="bottom" create="false" export_xlsx="0">
                <field name="product_id" string="Product" readonly="product_id" force_save="1"
                       context="{'default_is_storable': True}"/>
                <field name="reorder_description"/>
                <field name="location_id" options="{'no_create': True}" optional="show"
                       groups="stock.group_stock_multi_locations"/>
                <field name="reorder_on_order"/>
                <field name="qty_on_hand" force_save="1"/>
                <field name="qty_forecast" force_save="1"/>
                <field name="route_id" string="Routes" options="{'no_create': True, 'no_open': True}" optional="show"/>
                <field name="reorder_vendor_id" string="Vendor"/>
                <field name="reorder_min" string="Min"/>
                <field name="reorder_max" string="Max"/>
                <field name="reorder_to_order" string="To Order"/>
                <!-- Diagnostic: Stage 1 engine output, hidden by default. -->
                <field name="reorder_rgd" optional="show"/>
                <field name="product_uom_name" string="UoM" groups="uom.group_uom"/>
                <button name="%(stock.action_orderpoint_snooze)d" string="Snooze" type="action"
                        class="text-warning" icon="fa-bell-slash"
                        invisible="trigger != 'manual'" context="{'default_orderpoint_ids': [id]}"/>
                <button name="action_replenish" string="Reorder" type="object"
                        class="o_replenish_buttons" icon="fa-truck"
                        invisible="qty_to_order &lt;= 0.0"/>
                <button name="action_replenish_auto" string="Automate" type="object"
                        class="o_replenish_buttons" icon="fa-refresh"
                        invisible="qty_to_order &lt;= 0.0 or trigger == 'auto'"/>
            </list>
        </field>
    </record>

    <record id="view_reorder_suggestion_replenishment_search" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.reorder.suggestion.search</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="arch" type="xml">
            <search string="Re-Order Suggestions">
                <field name="product_id"/>
                <field name="reorder_vendor_id" string="Vendor"/>
                <filter string="Not Snoozed" name="filter_not_snoozed"
                        domain="['|', ('snoozed_until', '=', False), ('snoozed_until', '&lt;=', datetime.date.today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="groupby_vendor" string="Vendor"
                            context="{'group_by': 'reorder_vendor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reorder_suggestion_replenishment" model="ir.actions.act_window">
        <field name="name">Re-Order Suggestions</field>
        <field name="res_model">stock.warehouse.orderpoint</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_reorder_suggestion_replenishment_list"/>
        <field name="search_view_id" ref="view_reorder_suggestion_replenishment_search"/>
        <field name="context">{
            'search_default_groupby_vendor': 1,
            'search_default_filter_not_snoozed': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No re-order suggestions to display yet (mockup).
            </p>
            <p>
                This is the custom Re-Order Suggestions page. Rows and calculated
                Min / Max / To Order values are produced by the re-order
                calculation engine.
            </p>
        </field>
    </record>

    <menuitem id="menu_reorder_suggestion_replenishment"
              name="Re-Order Suggestions"
              parent="stock.menu_stock_procurement"
              action="action_reorder_suggestion_replenishment"
              sequence="6"/>
</odoo>
