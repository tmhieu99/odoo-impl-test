<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom Re-Order Suggestions replenishment page (mockup).
         Separate from the native replenishment page, which is left intact. -->
    <record id="view_reorder_suggestion_replenishment_list" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.reorder.suggestion.list</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="arch" type="xml">
            <list string="Re-Order Suggestions" editable="bottom" create="false" export_xlsx="0"
                    decoration-warning="not reorder_vendor_id">
                <field name="product_id" string="Product" readonly="product_id" force_save="1"
                       context="{'default_is_storable': True}"/>
                <field name="reorder_description"/>
                <field name="location_id" options="{'no_create': True}" optional="show"
                       groups="stock.group_stock_multi_locations"/>
                <field name="reorder_on_order"/>
                <field name="qty_on_hand" force_save="1"/>
                <field name="qty_forecast" force_save="1"/>
                <field name="route_id" string="Routes" options="{'no_create': True, 'no_open': True}" optional="show"/>
                <field name="reorder_vendor_id" string="Vendor"/>
                <!-- "No Vendor" badge: a button styled as a badge rather than a
                     stored warning field — an empty Vendor cell is the warning,
                     and clicking it opens the product where the vendor line is
                     added. -->
                <button name="action_open_product_vendors" type="object" string="No Vendor"
                        class="badge rounded-pill text-bg-warning border-0"
                        title="No vendor on this product, so no suggested vendor and no calculated quantities. Click to add one."
                        invisible="reorder_vendor_id"/>
                <field name="reorder_min" string="Min"/>
                <field name="reorder_max" string="Max"/>
                <field name="reorder_to_order" string="To Order"/>
                <!-- Diagnostic: engine output while the later stages are built. -->
                <field name="reorder_rgd" optional="show"/>
                <field name="reorder_wad" optional="show"/>
                <field name="reorder_wad_is_total" optional="show" widget="boolean_toggle"
                       readonly="1"/>
                <field name="product_uom_name" string="UoM" groups="uom.group_uom"/>
                <!-- Both buttons key off the custom suggested quantity, not native
                     qty_to_order: no suggestion, no action. The extra trigger
                     guard on Snooze stays because native write() raises a
                     UserError when an 'auto' row is snoozed. -->
                <button name="%(stock.action_orderpoint_snooze)d" string="Snooze" type="action"
                        class="text-warning" icon="fa-bell-slash"
                        invisible="reorder_to_order &lt;= 0.0 or trigger != 'manual'"
                        context="{'default_orderpoint_ids': [id]}"/>
                <!-- Snooze + manual Reorder only. Native "Automate"
                     (action_replenish_auto) is deliberately not offered: it flips
                     trigger to 'auto', which hands the row to the nightly
                     scheduler and turns a suggestion into unattended purchasing.
                     Reorder goes through the custom wrapper, which orders the
                     suggested To Order (Final TOQ) via the native replenish
                     flow; the native page keeps calling action_replenish and so
                     keeps ordering the native quantity. -->
                <button name="action_reorder_suggestion_replenish" string="Reorder" type="object"
                        class="o_replenish_buttons" icon="fa-truck"
                        invisible="reorder_to_order &lt;= 0.0"/>
            </list>
        </field>
    </record>

    <record id="view_reorder_suggestion_replenishment_search" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.reorder.suggestion.search</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="arch" type="xml">
            <search string="Re-Order Suggestions">
                <field name="product_id"/>
                <field name="reorder_vendor_id" string="Vendor"/>
                <filter string="Not Snoozed" name="filter_not_snoozed"
                        domain="['|', ('snoozed_until', '=', False), ('snoozed_until', '&lt;=', datetime.date.today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="groupby_vendor" string="Vendor"
                            context="{'group_by': 'reorder_vendor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reorder_suggestion_replenishment" model="ir.actions.act_window">
        <field name="name">Re-Order Suggestions</field>
        <field name="res_model">stock.warehouse.orderpoint</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_reorder_suggestion_replenishment_list"/>
        <field name="search_view_id" ref="view_reorder_suggestion_replenishment_search"/>
        <!-- Only SKUs opted into the suggestion flow. Without this the page is a
             second copy of native Reordering Rules: it would list every
             orderpoint in the database, including manufactured products that
             have no Buy route and can never produce a purchase suggestion.
             `automated_reorder_suggestions` is delegated from product.template,
             and it can only be True while Track Inventory, Can be Purchased and
             the Buy route are all set (it auto-clears otherwise), so the route
             check is implied. -->
        <field name="domain">[('product_id.automated_reorder_suggestions', '=', True)]</field>
        <field name="context">{
            'search_default_groupby_vendor': 1,
            'search_default_filter_not_snoozed': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No re-order suggestions to display.
            </p>
            <p>
                This page lists only products with <b>Automated Reorder Suggestions</b>
                enabled on the product form (Purchase tab), which requires Track
                Inventory, Can be Purchased and the Buy route. Calculated
                Min / Max / To Order values are produced by the re-order
                calculation engine.
            </p>
        </field>
    </record>

    <menuitem id="menu_reorder_suggestion_replenishment"
              name="Re-Order Suggestions"
              parent="stock.menu_stock_procurement"
              action="action_reorder_suggestion_replenishment"
              sequence="6"/>
</odoo>
